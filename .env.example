APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/thetabpos
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OWNER_EMAIL=owner@thetab.co.ke
OWNER_PASSWORD=Owner@123
# Set false on a real shop: the first owner registers from the login screen.
SEED_DEMO_DATA=true
OWNER_SIGNUP_EMAILS=
OWNER_SIGNUP_CODE=
APP_WEB_URL=http://localhost:5173
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4-flash
# Optional: web research for the AI analyst (https://dashboard.exa.ai).
EXA_API_KEY=
EXA_NUM_RESULTS=5

# M-Pesa (Safaricom Daraja). Leave empty to keep M-Pesa hidden.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/mpesa/callback
MPESA_CALLBACK_TOKEN=
MPESA_SIMULATE=false

# Password reset and login-code delivery.
RESET_CODE_LENGTH=6
RESET_CODE_EXPIRES_MINUTES=15
LOGIN_CODE_LENGTH=6
LOGIN_CODE_EXPIRES_MINUTES=10
SMS_API_URL=
SMS_API_TOKEN=

# Mailtrap SMTP. Keep the API token secret and set it only on the API service.
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_API_TOKEN=
MAILTRAP_FROM=hello@thetab.co.ke
MAILTRAP_FROM_NAME=The Tab POS
