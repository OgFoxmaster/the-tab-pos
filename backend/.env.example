APP_ENV=development
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/thetabpos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

SEED_DEMO_DATA=true
OWNER_EMAIL=owner@thetab.co.ke
OWNER_PASSWORD=Owner@123
MANAGER_EMAIL=manager@thetab.co.ke
MANAGER_PASSWORD=Manager@123
CASHIER_EMAIL=cashier@thetab.co.ke
CASHIER_PASSWORD=Cashier@123
STOCK_EMAIL=stock@thetab.co.ke
STOCK_PASSWORD=Stock@123

# Store identity printed on receipts and used by reports
STORE_NAME=The Tab
STORE_TAGLINE=Liquor Store
STORE_ADDRESS=Nairobi, Kenya
STORE_PHONE=+254 700 000 000
STORE_CURRENCY=KES
STORE_RECEIPT_FOOTER=Thank you for shopping with The Tab. Drink responsibly.
# Prices are treated as VAT-inclusive; set 0 to hide the VAT breakdown
VAT_RATE=0.16

# AI sales analyst (Z.ai / any OpenAI-compatible chat completions endpoint)
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4-flash
AI_DAILY_LIMIT=40

# Optional web research through Exa (https://dashboard.exa.ai)
EXA_API_KEY=
EXA_NUM_RESULTS=5

# Offline till replays
OFFLINE_SALE_MAX_AGE_DAYS=14
OFFLINE_SALE_MAX_FUTURE_MINUTES=10

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=http://localhost:8000/mpesa/callback
MPESA_TIMEOUT_URL=http://localhost:8000/mpesa/timeout
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Extra secret appended to the callback URL. Set a long random value in production.
MPESA_CALLBACK_TOKEN=
# Development only; ignored when APP_ENV=production. Lets you test paid/failed flows.
MPESA_SIMULATE=false

# Owner self-registration and password reset
# Empty allowlist = only the first owner can be claimed. Add Gmail addresses to
# allow more owners later. OWNER_SIGNUP_CODE adds a shared secret on top.
OWNER_SIGNUP_EMAILS=
OWNER_SIGNUP_CODE=
APP_WEB_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30

# Password reset email over SMTP. For Gmail use smtp.gmail.com, port 587 and an
# App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
